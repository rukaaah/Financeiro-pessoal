# Copie para .env.local e ajuste. O .env.local NUNCA entra no Git.
#
# Postgres local do docker-compose.yml (não é segredo: é descartável).
DATABASE_URL=postgresql+psycopg://owner:dev@localhost:5433/financeiro

# Em produção/dev no Neon, use a connection string do papel `owner`,
# pegue-a no painel do Neon e mantenha-a apenas em .env.local.
# DATABASE_URL=postgresql+psycopg://owner:...@...neon.tech/financeiro?sslmode=require
